# =================================================================
# Forma3D Environment Variables
# =================================================================

# ─── BACKEND CONFIGURATION (Render Web Service) ──────────────────
NODE_ENV=production
API_PORT=4000
API_URL=https://your-backend-api.onrender.com
WEB_URL=https://your-frontend-site.onrender.com

# PostgreSQL Connection (Use Render Managed PostgreSQL Internal/External URL)
DATABASE_URL="postgresql://postgres:password@host:5432/forma3d?schema=public"

# Tripo AI API Key (Obtain from https://platform.tripo3d.ai/)
TRIPO_API_KEY=""

# ─── FRONTEND CONFIGURATION (Render Static Site) ─────────────────
# Point this to your Render backend web service URL:
VITE_API_URL=https://your-backend-api.onrender.com
