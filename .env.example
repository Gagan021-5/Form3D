# Forma3D Environment Variables
# Copy this file to .env in local development:
#   cp .env.example .env

NODE_ENV=development
WEB_URL=http://localhost:5173
API_PORT=4000
API_URL=http://localhost:4000

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/forma3d?schema=public"

# Tripo 3D Engine API Key (Get free key from https://platform.tripo3d.ai)
TRIPO_API_KEY=your_tripo_api_key_here

# Local Storage Directory
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=10
MAX_MODEL_UPLOAD_SIZE_MB=100

# Polling and Timeout
GENERATION_POLL_INTERVAL_MS=5000
GENERATION_TIMEOUT_MS=600000
LOG_LEVEL=info

# FOR RENDER DEPLOYMENT:
# In Render Static Site (Frontend):
#   Set VITE_API_URL=https://your-backend-web-service.onrender.com
# In Render Web Service (Backend):
#   Set DATABASE_URL and TRIPO_API_KEY
